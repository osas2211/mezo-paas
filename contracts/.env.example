# Mezo Testnet Configuration
# Copy this file to .env and fill in your values

# RPC Endpoint
MEZO_RPC_URL=https://rpc.test.mezo.org

# CRITICAL: These MUST be different addresses!
# Owner: Controls admin functions (pause, treasury moves, emergency withdraw)
MEZO_OWNER_PRIVATE_KEY=0x_your_owner_private_key_here

# Treasury: Receives funds from collateral moves
MEZO_TREASURY_PRIVATE_KEY=0x_your_treasury_private_key_here

# Optional: ERC20 token address (if not set, MockBTC will be deployed)
# TOKEN_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
