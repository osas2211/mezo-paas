// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String        @id @default(uuid())
  name                 String
  email                String        @unique
  password             String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  wallet               Wallet?
  githubAccessToken    String?
  githubInstallationId String?
  githubUsername       String?
  projects             Project[]
  role                 Role          @default(REGULAR_DEVELOPER)
  transactions         Transaction[]
}

model Wallet {
  id                String   @id @default(uuid())
  encryptedPK       String
  address           String   @unique
  encryptedMnemonic String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
  userId            String   @unique

  // Balance for daily consumption for regular developers
  creditBalance String @default("0")

  // Balance for pro developers for staking to unlock pro features
  stakedBalance String @default("0")
}

model Project {
  id                   String       @id @default(uuid())
  name                 String
  description          String?
  framework            Framework
  nodeVersion          String
  buildCommand         String?
  installCommand       String?
  outputDirectory      String?
  devCommand           String?
  gitRepositoryName    String?
  gitRepositoryOwner   String?
  gitRepositoryType    GitProvider?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  user                 User         @relation(fields: [userId], references: [id])
  userId               String
  deployment           Deployment?
  environmentVariables String?
  active               Boolean      @default(true)
  dailyCreditCost      String       @default("0") // in MHCredit (1 credit = 0.001$) 
  creditUsedThisMonth  String       @default("0")
}

model Deployment {
  id                   String           @id @default(uuid())
  project              Project          @relation(fields: [projectId], references: [id])
  projectId            String           @unique
  status               DeploymentStatus @default(PENDING_DEPLOYMENT)
  url                  String
  port                 String?
  name                 String?
  buildLogs            String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deploymentStartedAt  DateTime?
  deploymentFinishedAt DateTime?
}

enum Role {
  REGULAR_DEVELOPER
  PRO_DEVELOPER
}

enum Framework {
  nextjs
  nestjs
  vite
  astro
  bun
  html
  reactjs
  nuxtjs
  sveltejs
  remix
  angular
  gatsby
  sveltekit
  node
}

enum GitProvider {
  github
  gitlab
  bitbucket
}

enum DeploymentStatus {
  PENDING_DEPLOYMENT
  QUEUED_FOR_BUILDING
  BUILDING
  READY
  ERROR
  CANCELED
  SUSPENDED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  Pending
  Success
  Failed
}

enum TransactionAction {
  Transfer
  Deposit
  Withdraw
  Billing
}

model Transaction {
  id        String            @id @default(uuid())
  user      User              @relation(fields: [userId], references: [id])
  userId    String
  amount    String
  type      TransactionType
  status    TransactionStatus @default(Success)
  action    TransactionAction
  title     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}
